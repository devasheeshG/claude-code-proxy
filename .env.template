# ============================================================================
# Claude Code Team Proxy — single global config.
# Copy to `.env` (kept out of git). Used by BOTH the backend app and
# docker-compose (Traefik host + backend env_file).
# ============================================================================

# --- Ingress (Traefik) ------------------------------------------------------
# Full domain the proxy is served on. Dashboard at https://${DOMAIN}/ and the backend (proxy + admin API) at https://${DOMAIN}/api.
# Employees set ANTHROPIC_BASE_URL to https://${DOMAIN}/api.
DOMAIN=claude-proxy.example.com

# --- Secrets (REQUIRED) -----------------------------------------------------
# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Admin dashboard login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Signs admin session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-too

# --- Database (your global PostgreSQL) --------------------------------------
# The async URL is built from these. POSTGRES_HOST is the DB's hostname on the shared network (e.g. the container name of your global Postgres).
# Use a dedicated POSTGRES_DB for this service.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=claude_code_proxy

# --- Rotation policy --------------------------------------------------------
# Rotate away from an account once 5h OR 7d utilization reaches this fraction.
ROTATION_THRESHOLD=0.95
# Min cooldown after a 429 with no usable retry-after (seconds).
DEFAULT_COOLDOWN_SECONDS=60
# How many accounts to try for one request before giving up.
MAX_FAILOVER_ATTEMPTS=3
